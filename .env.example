# -----------------------------------------------------------------------------
# Telegram Moderatsiya Boti (Block-BOT) - Konfiguratsiya
# -----------------------------------------------------------------------------

# Muhit va asosiy sozlamalar
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tashkent
DATA_RETENTION_DAYS=60
# Ixtiyoriy: bin/healthcheck.php muammo davom etganda necha soniyada bir marta
# TELEGRAM_OWNER_IDSga eslatma yuborishi (standart: 1800s/30 daqiqa).
# HEALTHCHECK_REALERT_SEC=1800
# Ixtiyoriy: bir nechta bin/worker.php jarayonini parallel ishlatganda (gorizontal
# scaling, faqat DB_DRIVER=mysql bilan tavsiya etiladi — README_VPS.md 3.1-bandiga
# qarang), har birini o'ziga xos qiymat bilan ishga tushiring (masalan WORKER_ID=1),
# shunda health-check har birini alohida kuzatadi. Bitta workerli standart o'rnatishda
# kerak emas.
# WORKER_ID=1
# Ixtiyoriy: storage/logs/*.log fayllari avtomatik rotatsiyasi (Phase 2). Standart
# qiymatlar odatda yetarli — README_VPS.md 5.1-bandiga qarang.
# LOG_MAX_SIZE_BYTES=10485760
# LOG_MAX_BACKUPS=5
# LOG_COMPRESS_BACKUPS=true
# Ixtiyoriy: Telegram Stars monetizatsiyasi (Phase 3). Bepul tarifda bitta guruh
# kuniga necha marta AI tekshiruvidan foydalana oladi (matn/rasm/video/ovoz
# birgalikda hisoblanadi). 0 yoki manfiy qiymat — chegarani butunlay o'chiradi.
# Chegaradan oshgach ham mahalliy qoidalar (so'z bloklash, havola filtri va h.k.)
# ishlashda davom etadi — faqat AI tahlil o'sha kun uchun to'xtaydi.
# FREE_TIER_DAILY_AI_REQUESTS=150
# Premium narxi (Telegram Stars, XTR) va muddati (kun) — /premium buyrug'idagi
# "Sotib olish" tugmasida ko'rsatiladi va sendInvoice()ga shu qiymatlar bilan yuboriladi.
# PREMIUM_STARS_PRICE=200
# PREMIUM_DURATION_DAYS=30
# Ixtiyoriy: Web Dashboard / Telegram Mini App manzili (2.0 Phase 3, 3-band).
# Bo'sh qoldirilsa, TELEGRAM_WEBHOOK_URL domenidan avtomatik hosil qilinadi
# (https://domain/miniapp/) — public/miniapp/ ham shu domenda joylashgani uchun
# odatda alohida sozlash shart emas. FAQAT https:// qabul qilinadi (Telegram talabi);
# mos kelmasa botning bosh menyusida "📊 Dashboard" tugmasi ko'rsatilmaydi.
# MINIAPP_URL=https://your-domain.com/miniapp/

# Ma'lumotlar bazasi (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=block_bot
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Telegram Bot API sozlamalari
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=MyModBot
# Reg.ru yoki RKN blokirovkasini aylanib o'tish uchun Cloudflare Worker manzili (masalan: https://my-proxy.workers.dev)
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Ixtiyoriy SOCKS5/HTTP proksi (masalan: socks5h://127.0.0.1:1080)
TELEGRAM_PROXY=
# Ixtiyoriy Cloudflare Worker maxfiy kaliti (begonalar foydalanmasligi uchun)
TELEGRAM_PROXY_SECRET=
TELEGRAM_WEBHOOK_SECRET=your_super_secret_webhook_key_min_32_chars
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook.php
TELEGRAM_ADMIN_LOG_CHAT_ID=
# Ixtiyoriy: butun platformani boshqaruvchi superadmin IDlari (mijoz adminlari bu yerga yozilmaydi)
TELEGRAM_OWNER_IDS=

# AI provider: gemini yoki openrouter
AI_PROVIDER=gemini

# Google Gemini API (AI_PROVIDER=gemini bo'lganda).
# Yangi Auth key odatda AQ. bilan, eski Standard key esa AIza bilan boshlanadi.
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
# Google ba'zi mamlakatlar (masalan Rossiya/Belarus) IP manzillaridan so'rovlarni
# "User location is not supported" xatosi bilan rad etadi. Shu holatda
# deploy/cloudflare-worker/telegram-proxy.js ni joylang va bu yerni
# https://<worker>.workers.dev/gemini/v1beta ga o'zgartiring (php bin/doctor.php aniqlab beradi).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# Ixtiyoriy: ovozli/audio xabarlar (voice/audio) uchun alohida model. Belgilanmasa
# GEMINI_VISION_MODEL bilan bir xil ishlatiladi — odatda o'zgartirish shart emas.
# GEMINI_AUDIO_MODEL=gemini-2.5-flash

# OpenRouter (AI_PROVIDER=openrouter bo'lganda, ixtiyoriy)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bloklangan taqdirda: https://<worker>.workers.dev/openrouter/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Google Cloud Vision "SafeSearch Detection" (ixtiyoriy, tavsiya etiladi).
# Gemini/OpenRouter o'ta ochiq kontentni tahlil qilishdan yashirin bosh tortib,
# "review" yoki tushunarsiz javob qaytarganda ZAXIRA tekshiruv sifatida ishlaydi
# (Gemini'dan farqli, bu API hech qachon bosh tortmaydi — faqat foiz qaytaradi).
# Kalit olish: console.cloud.google.com -> API va xizmatlar -> "Cloud Vision API" ni yoqing.
# Bo'sh qoldirilsa, bu funksiya shunchaki chetlab o'tiladi.
GOOGLE_VISION_API_KEY=
# Bloklangan taqdirda: https://<worker>.workers.dev/vision/v1
GOOGLE_VISION_BASE_URL=https://vision.googleapis.com/v1
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
AI_DAILY_BUDGET_USD=1.00
AI_MONTHLY_BUDGET_USD=25.00
# comprehensive = har bir xabar tanlangan AI orqali ham tekshiriladi
AI_DEFAULT_MODE=comprehensive

# Media qayta ishlash
FFMPEG_PATH=ffmpeg
MAX_UPLOAD_SIZE_BYTES=20971520

# MTProto sozlamalari (Ixtiyoriy - faqat tarixiy audit uchun)
MTPROTO_API_ID=
MTPROTO_API_HASH=
MTPROTO_SESSION_PATH=storage/sessions/mtproto.session
MTPROTO_ALLOWED_CHATS=
